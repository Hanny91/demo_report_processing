# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real credentials.
#
# Register an API client at https://podio.com/settings/api
#
# UNVERIFIED: Podio's docs say the redirect_uri "must be on the same domain
# as the domain you specified when you applied for your API Key." It's not
# documented whether a newly-registered client accepts a localhost redirect.
# Try http://localhost:8080/callback first; if Podio rejects it at the
# authorize step, you'll need a tunnel (e.g. ngrok) or a real domain instead
# (see the appendix of project.md for the localtest.me
# workaround used in the sandbox).
PODIO_CLIENT_ID=
PODIO_CLIENT_SECRET=
PODIO_REDIRECT_URI=http://localhost:8080/callback

# --- podio_oauth_spike.py ---
# The numeric item_id of a report to fetch — NOT the app_item_id shown in
# the Podio UI (see project.md §7 on why
# these two are easy to confuse). If you don't know it yet, set
# PODIO_REPORT_APP_ID below and run:
#   python podio_oauth_spike.py --list-items
# which authenticates and lists item_id/app_item_id/title for every item in
# that app so you can pick one.
PODIO_REPORT_ITEM_ID=

# --- seed_reports.py ---
PODIO_REPORT_APP_ID=
PODIO_PROFILE_ITEM_ID=

# --- setup_podio_app.py ---
# Space to create the "Suggested Profile Updates" app in.
PODIO_SPACE_ID=
# Existing Child Profile app — referenced by the new app's `child` field.
PODIO_PROFILE_APP_ID=

# --- python -m yw.run ---
# Also uses PODIO_REPORT_APP_ID above.
# The Suggested Profile Updates app created by setup_podio_app.py.
PODIO_PROPOSALS_APP_ID=
